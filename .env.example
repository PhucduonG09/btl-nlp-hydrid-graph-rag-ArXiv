# Sao chép thành .env rồi điền key. KHÔNG commit file .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.miraiapi.com/v1
LLM_MODEL=gpt-6-astra
# Model chấm điểm: nên khác họ với LLM_MODEL để giảm thiên vị tự chấm
LLM_JUDGE_MODEL=claude-sonnet-5.5
# (tùy chọn) đơn giá USD / 1 triệu token, để script in ước tính chi phí
LLM_PRICE_IN=
LLM_PRICE_OUT=
